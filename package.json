{
    "name": "notify-relay",
    "description": "A stateless notification relay on Cloudflare Workers",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/muhac/notify-relay.git"
    },
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "test": "vitest run",
        "typecheck": "wrangler types && tsc --noEmit -p . && tsc --noEmit -p test",
        "build": "wrangler deploy --dry-run --outdir dist",
        "dev": "wrangler dev"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "1.4.0",
        "typescript": "7.0.2",
        "vitest": "5.0.3",
        "wrangler": "4.149.0"
    }
}
