{
    "name": "notify-relay",
    "description": "A stateless notification relay on Cloudflare Workers",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/theRank/notify-relay.git"
    },
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "test": "vitest run",
        "test:live": "vitest run --config vitest.live.config.ts",
        "typecheck": "wrangler types && tsc --noEmit -p . && tsc --noEmit -p test",
        "build": "wrangler deploy --dry-run --outdir dist",
        "dev": "wrangler dev"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "1.4.4",
        "typescript": "7.0.2",
        "vitest": "5.0.5",
        "wrangler": "4.151.1"
    }
}
